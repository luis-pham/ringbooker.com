generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id             String     @id @default(cuid())
  /// Public URL path before slug: /{pathPrefix}/{slug} (e.g. blog, industries/nail-salon).
  pathPrefix     String     @default("blog")
  slug           String
  title          String
  excerpt        String
  /// Optional search / social meta description (plain text). When empty, excerpt + body fallbacks apply.
  metaDescription String?   @db.Text
  content        String     @db.Text
  /// Public URL path (e.g. /uploads/blog/...) or absolute https URL for list/detail hero
  coverImageUrl  String?
  coverStats     Json?
  /// End-of-article CTAs: [{ "kind", "primaryHref", "secondaryHref" }, ...] (legacy: templateId or buttonId+ctaCopyId+href)
  footerCtas     Json?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
  readTimeMin Int        @default(5)
  views       Int        @default(0)
  featured    Boolean    @default(false)
  /// When the post uses a hub `pathPrefix`, controls listing on that hub’s index (e.g. "In this hub" block).
  showInHub   Boolean    @default(true)

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  categories  CategoryOnPost[]
  tags        TagOnPost[]
  relatedFrom Post[]           @relation("RelatedPosts")
  relatedTo   Post[]           @relation("RelatedPosts")

  @@unique([pathPrefix, slug])
  @@index([status, publishedAt])
  @@index([authorId])
  @@index([featured])
}

model Author {
  id       String  @id @default(cuid())
  name     String
  role     String
  initials String  @unique
  avatar   String?
  posts    Post[]

  @@index([name])
}

model Category {
  id    String           @id @default(cuid())
  name  String           @unique
  slug  String           @unique
  posts CategoryOnPost[]
}

model Tag {
  id    String      @id @default(cuid())
  name  String      @unique
  slug  String      @unique
  posts TagOnPost[]
}

model CategoryOnPost {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model TagOnPost {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

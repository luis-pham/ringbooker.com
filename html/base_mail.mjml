<mjml>
  <mj-head>
    <mj-title>{{rb_email_title}}</mj-title>
    <mj-preview>{{rb_preview_text}}</mj-preview>

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="15px" line-height="23px" color="#374151" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button font-size="16px" font-weight="700" border-radius="8px" inner-padding="14px 28px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f6f8">

    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="0">

      <mj-section padding="32px 32px 20px 32px">
        <mj-column>
          <mj-image
            src="https://ringbooker.com/images/mail_logo.jpg"
            alt="RingBooker"
            width="56px"
            height="56px"
            border-radius="12px"
            padding="0"
          />
        </mj-column>
      </mj-section>

      <mj-section padding="0 32px">
        <mj-column>
          <mj-divider border-width="1px" border-color="#e5e7eb" padding="0" />
        </mj-column>
      </mj-section>

      <mj-section padding="40px 32px 16px 32px">
        <mj-column>
          <mj-text
            align="center"
            font-size="32px"
            line-height="40px"
            font-weight="700"
            color="#111827"
            padding="0"
          >
            {{rb_hero_title}}
          </mj-text>
<!--@@RB_HERO_SUBTITLE@@-->
          <mj-text
            align="center"
            font-size="16px"
            line-height="24px"
            color="#4b5563"
            padding="16px 0 0 0"
          >
            {{rb_hero_subtitle_html}}
          </mj-text>
<!--@@/RB_HERO_SUBTITLE@@-->
        </mj-column>
      </mj-section>

      <mj-section padding="24px 32px 8px 32px">
        <mj-column
          background-color="#f3e8ff"
          border-radius="12px"
          padding="20px"
        >
<!--@@RB_GREETING@@-->
          <mj-text padding="0" color="#312e81">
            {{rb_greeting_html}}
          </mj-text>
<!--@@/RB_GREETING@@-->

          <mj-text padding="12px 0 0 0" color="#312e81">
            {{rb_body_html}}
          </mj-text>

<!--@@RB_CTA@@-->
          <mj-button
            background-color="#8B5CF6"
            color="#ffffff"
            href="{{rb_cta_url}}"
            padding="20px 0 4px 0"
          >
            {{rb_cta_label}}
          </mj-button>
<!--@@/RB_CTA@@-->

<!--@@RB_SECONDARY@@-->
          <mj-text padding="16px 0 0 0" color="#312e81">
            {{rb_secondary_body_html}}
          </mj-text>
<!--@@/RB_SECONDARY@@-->

<!--@@RB_SIGNATURE@@-->
          <mj-text padding="16px 0 0 0" color="#312e81">
            {{rb_signature_html}}
          </mj-text>
<!--@@/RB_SIGNATURE@@-->
        </mj-column>
      </mj-section>

<!--@@RB_LINK_FALLBACK@@-->
      <mj-section padding="24px 32px 8px 32px">
        <mj-column>
          <mj-text
            align="center"
            font-size="13px"
            line-height="20px"
            color="#6b7280"
            padding="0"
          >
            If the button does not work, copy and paste this link into your browser:
          </mj-text>

          <mj-text
            align="center"
            font-size="13px"
            line-height="20px"
            color="#2563eb"
            padding="8px 0 0 0"
          >
            <a href="{{rb_cta_url}}" target="_blank" style="color:#2563eb; text-decoration:underline; word-break:break-all;">
              {{rb_cta_url_display}}
            </a>
          </mj-text>
        </mj-column>
      </mj-section>
<!--@@/RB_LINK_FALLBACK@@-->

<!--@@RB_SECURITY@@-->
      <mj-section padding="24px 32px 32px 32px">
        <mj-column>
          <mj-text
            align="center"
            font-size="12px"
            line-height="18px"
            color="#9ca3af"
            padding="0"
          >
            {{rb_security_note}}
          </mj-text>
        </mj-column>
      </mj-section>
<!--@@/RB_SECURITY@@-->

      <mj-section background-color="#f3f4f6" padding="24px 32px">
        <mj-column>
          <mj-text
            align="center"
            font-size="13px"
            line-height="20px"
            color="#6b7280"
            padding="0"
          >
            <a href="https://ringbooker.com" target="_blank" style="color:#2563eb; text-decoration:none;">Website</a>
            &nbsp;&nbsp;|&nbsp;&nbsp;
            <a href="https://ringbooker.com/pricing" target="_blank" style="color:#2563eb; text-decoration:none;">Pricing</a>
            &nbsp;&nbsp;|&nbsp;&nbsp;
            <a href="mailto:hello@ringbooker.com" style="color:#2563eb; text-decoration:none;">Contact</a>
          </mj-text>

          <mj-text
            align="center"
            font-size="12px"
            line-height="18px"
            color="#9ca3af"
            padding="10px 0 0 0"
          >
            Sent by RingBooker
          </mj-text>

          <mj-text
            align="center"
            font-size="12px"
            line-height="18px"
            color="#9ca3af"
            padding="8px 0 0 0"
          >
            Reply to this email to contact us.
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

  </mj-body>
</mjml>

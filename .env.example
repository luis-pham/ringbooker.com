# App
APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Optional JSON map for sitemap.xml <lastmod> on static routes (CMS/blog posts use DB `updatedAt`).
# Keys are route paths, values are ISO dates (YYYY-MM-DD or full ISO datetime).
# Example:
# SITEMAP_STATIC_LASTMOD={"\/":"2026-04-28","\/industries\/nail-salon":"2026-04-20","\/industries\/hair-salon":"2026-04-20","\/industries\/spa":"2026-04-20","\/industries\/med-spa":"2026-04-28","\/industries\/beauty-clinic":"2026-04-25","\/pricing":"2026-04-20","\/how-it-works":"2026-04-20","\/current-number\/call-forwarding":"2026-04-20"}

# Backend wiring
BACKEND_REPOSITORY_MODE=memory
BACKEND_COMM_PROVIDER=noop
BILLING_PROVIDER=paddle
AGENT_RUNTIME_MODE=mock
AGENT_TRANSPORT=mock
AGENT_VOICE_PROVIDER=none
AGENT_VOICE_MODEL=gemini-3.1-flash-live-preview
# Production profile example:
# BACKEND_REPOSITORY_MODE=supabase
# BACKEND_COMM_PROVIDER=telnyx
# AGENT_TRANSPORT=livekit
# AGENT_VOICE_PROVIDER=gemini_live
# AGENT_VOICE_MODEL=gemini-3.1-flash-live-preview
# Legacy fallback still supported:
# AGENT_RUNTIME_MODE=livekit_gemini
# OpenAI Realtime over LiveKit:
# AGENT_RUNTIME_MODE=livekit_openai
# AGENT_VOICE_PROVIDER=openai_realtime
# AGENT_VOICE_MODEL=gpt-realtime-mini
# Recommended LiveKit+OpenAI native path (AgentSession + RealtimeModel plugin):
# AGENT_RUNTIME_MODE=livekit_native_openai
# AGENT_LIVEKIT_NATIVE_OPENAI_AGENT_NAME=ringbooker-native-openai
# Recommended LiveKit+Gemini path (AgentSession + RealtimeModel plugin):
# AGENT_RUNTIME_MODE=livekit_native_gemini
AGENT_GEMINI_MODEL=gemini-3.1-flash-live-preview
AGENT_GEMINI_LATENCY_PRESET=ultra_low_latency
AGENT_GEMINI_THINKING_LEVEL=minimal
AGENT_GEMINI_VAD_START_SENSITIVITY=low
AGENT_GEMINI_VAD_END_SENSITIVITY=low
AGENT_GEMINI_VAD_PREFIX_MS=20
AGENT_GEMINI_VAD_SILENCE_MS=100
AGENT_GEMINI_CONTEXT_COMPRESSION_ENABLED=true
AGENT_GEMINI_SYSTEM_PROMPT_MAX_CHARS=7000
AGENT_GEMINI_TOOL_OUTPUT_MAX_CHARS=3000
AGENT_REALTIME_LOW_LATENCY_PREFERRED=true
AGENT_REALTIME_UPLINK_CHUNK_MS=20
AGENT_GEMINI_UPLINK_CHUNK_MS=20
AGENT_OPENAI_UPLINK_CHUNK_MS=20
AGENT_OPENAI_VOICE=alloy
AGENT_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AGENT_OPENAI_INPUT_TRANSCRIPTION_ENABLED=true
# Optional override. Leave unset so production uses shop policy:
# Starter/English-only => en; Professional/Enterprise multilingual => auto-detect by omitting language.
# AGENT_OPENAI_INPUT_TRANSCRIPTION_LANGUAGE=en
# Legacy name: NOT "force server_vad". true = OpenAI turn detection ON; false = turn_detection null (manual / push-to-talk style).
# Pick mode with AGENT_OPENAI_TURN_DETECTION: semantic_vad | (anything else or unset) => server_vad.
AGENT_OPENAI_SERVER_VAD_ENABLED=true
AGENT_OPENAI_TURN_DETECTION=semantic_vad
AGENT_OPENAI_SEMANTIC_VAD_EAGERNESS=low
AGENT_OPENAI_CREATE_RESPONSE=true
AGENT_OPENAI_INTERRUPT_RESPONSE=true
AGENT_OPENAI_VAD_THRESHOLD=0.45
AGENT_OPENAI_VAD_PREFIX_MS=500
AGENT_OPENAI_VAD_SILENCE_MS=900
AGENT_OPENAI_VAD_IDLE_TIMEOUT_MS=10000
# Browser web demos can tune turn detection separately from phone/SIP.
# PUBLIC_DEMO_OPENAI_* is for the public marketing demo; USER_DEMO_OPENAI_* is for onboarding/user embeds.
# Missing demo-specific values fall back to WEB_DEMO_OPENAI_* and then AGENT_OPENAI_*.
PUBLIC_DEMO_OPENAI_TURN_DETECTION=semantic_vad
PUBLIC_DEMO_OPENAI_SEMANTIC_VAD_EAGERNESS=medium
PUBLIC_DEMO_OPENAI_CREATE_RESPONSE=true
PUBLIC_DEMO_OPENAI_INTERRUPT_RESPONSE=true
USER_DEMO_OPENAI_TURN_DETECTION=semantic_vad
USER_DEMO_OPENAI_SEMANTIC_VAD_EAGERNESS=medium
USER_DEMO_OPENAI_CREATE_RESPONSE=true
USER_DEMO_OPENAI_INTERRUPT_RESPONSE=true
AGENT_OPENAI_LOCAL_ENDPOINT_DELAY_MS=220
AGENT_OPENAI_OUTPUT_SAMPLE_RATE=24000
AGENT_OPENAI_SYSTEM_PROMPT_MAX_CHARS=7000
AGENT_OPENAI_TOOL_OUTPUT_MAX_CHARS=3000
# Debug: log full OpenAI realtime server payloads (verbose; use short test calls only)
AGENT_OPENAI_LOG_ALL_SERVER_EVENTS=false
# Optional. Warn if no assistant audio this long after initial generateReply (default 8000)
AGENT_OPENAI_GREETING_AUDIO_WAIT_MS=8000
AGENT_CALENDAR_WARMUP_DAYS=2
# Optional. Fallback is ${APP_BASE_URL}/api/backend/agent/dispatch
AGENT_DISPATCH_WEBHOOK_URL=
AGENT_DISPATCH_AUTH_TOKEN=
# Optional. Command used by dispatch handler to spawn LiveKit/Gemini agent worker
# Example: tsx src/agent/realtime/worker-entry.ts
AGENT_LIVEKIT_AGENT_COMMAND=
# Optional. Agent name for the long-running LiveKit-native OpenAI worker
AGENT_LIVEKIT_NATIVE_OPENAI_AGENT_NAME=ringbooker-native-openai
AGENT_WORKER_MAX_SESSION_MS=1800000
AGENT_GEMINI_OUTPUT_SAMPLE_RATE=24000
AGENT_AUDIO_METRICS_INTERVAL_MS=10000
AGENT_USER_SPEECH_END_HOLD_MS=140
# Optional. When set, include header: x-backend-key
# BACKEND_INTERNAL_API_KEY=replace-with-strong-key
# Recommended in production:
# BACKEND_INTERNAL_API_KEY=replace-with-strong-key
# Must equal sales.ringbooker.com RINGBOOKER_INTERNAL_API_KEY (auth for /internal/sales/demo-context).

# sales.ringbooker.com integration — outbound demo tracking + lifecycle webhooks.
# Base URL of the sales app; secret must equal sales RINGBOOKER_WEBHOOK_SECRET.
# SALES_WEBHOOK_BASE_URL=https://sales.ringbooker.com
# SALES_WEBHOOK_SECRET=replace-with-shared-secret
# Enforce production runtime profile at startup (recommended in CI/deploy):
# ENFORCE_PRODUCTION_RUNTIME_PROFILE=true
# Emergency override (do not keep enabled):
# ALLOW_INSECURE_PROD_RUNTIME=false

# Dev-memory bootstrap credentials (used by in-memory auth repo only)
# Production should create auth_users records in database and not rely on these.
USER_AUTH_EMAIL=user@ringbooker.local
USER_AUTH_PASSWORD=change_me_user_password
USER_AUTH_SHOP_ID=demo-shop
ADMIN_AUTH_EMAIL=admin@ringbooker.local
ADMIN_AUTH_PASSWORD=change_me_admin_password

# LiveKit

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Emergency only until SQL backfill (scripts/backfill-forwarding-verification-legacy-live.sql): ISO instant.
# Shops live before this timestamp with telnyx_number may pass forwarding verification without DB column set.
# RB_FORWARDING_VERIFICATION_GRANDFATHER_GO_LIVE_BEFORE=

# Telnyx
TELNYX_API_KEY=
TELNYX_APP_ID=
# Outbound caller ID for authenticated "call me" trial tests (POST /user/test-calls/call-me). Not shop.phone_number.
RINGBOOKER_OUTBOUND_CALLER_ID=
# Optional alias if RINGBOOKER_OUTBOUND_CALLER_ID is unset.
# TELNYX_OUTBOUND_CALLER_ID=
TELNYX_MESSAGING_PROFILE=
TELNYX_SMS_SENDER_NUMBER=+18888401886
# PEM (-----BEGIN PUBLIC KEY-----) or Mission Control base64 raw Ed25519 public key (32 bytes when decoded)
TELNYX_WEBHOOK_PUBLIC_KEY=
TELNYX_WEBHOOK_MAX_SKEW_SECONDS=300
# Inbound PSTN routing mode (legacy fallback / startup warnings):
# - texml_to_openai_sip — point Telnyx number Voice URL at POST|GET …/telnyx/texml/inbound (TeXML → OPENAI_SIP_URI).
# - call_control_to_openai_sip — attach number to a Call Control Application; webhook …/webhooks/telnyx/call-control.
TELNYX_INBOUND_ROUTING_MODE=texml_to_openai_sip
# Optional route-specific overrides. Use these when demo vertical numbers stay on TeXML but real shop numbers use Call Control.
# TELNYX_SHOP_INBOUND_ROUTING_MODE=call_control_to_openai_sip
# TELNYX_DEMO_INBOUND_ROUTING_MODE=texml_to_openai_sip

# Voice stack (OpenAI SIP direct = media via OpenAI Realtime SIP; handoff uses Telnyx Call Control, not LiveKit).
VOICE_TRANSPORT=openai_sip_direct
HANDOFF_TRANSPORT=telnyx_call_control

# Telnyx Call Control Application webhook URL (production uses base path): POST …/api/backend/webhooks/telnyx/call-control
TELNYX_CALL_CONTROL_WEBHOOK_ENABLED=false
# When true (default), no answer/reject REST calls — safe for staging until ready
TELNYX_CALL_CONTROL_DRY_RUN=true
# After answer, dial OPENAI_SIP_URI and bridge (requires OPENAI_SIP_URI + valid connection_id)
TELNYX_CALL_CONTROL_BRIDGE_OPENAI_SIP=false
# Optional; defaults to TELNYX_APP_ID
# TELNYX_CALL_CONTROL_CONNECTION_ID=
# Ring timeout (seconds) on POST /v2/calls for OpenAI SIP leg; default 15 when unset.
# TELNYX_OPENAI_SIP_LEG_TIMEOUT_SECS=15
# When true, add max_duration_secs to inbound answer. Default true.
# TELNYX_ANSWER_MAX_DURATION_ENABLED=true
# Used with TELNYX_ANSWER_MAX_DURATION_ENABLED (seconds). Default 300 (5-min demo cap).
# TELNYX_INBOUND_MAX_DURATION_SECS=300
# Verify the Ed25519 signature on TeXML Voice URL POSTs. Default true. Set false only if your
# Telnyx TeXML application is not configured to sign webhooks.
# TELNYX_TEXML_VERIFY_SIGNATURE=true
# Provider-side hard duration cap (seconds) for demo TeXML <Dial timeLimit>. Default 300.
# TELNYX_TEXML_DEMO_MAX_DURATION_SECS=300
# transfer | create_and_bridge | texml_fallback | disabled
TELNYX_OPENAI_CONNECT_MODE=create_and_bridge
# Optional Telnyx REST timeouts (ms); defaults used if unset
# TELNYX_CALL_CONTROL_TIMEOUT_MS=
# TELNYX_SMS_TIMEOUT_MS=
# TELNYX_PROVISIONING_TIMEOUT_MS=
# TELNYX_OUTBOUND_CALL_TIMEOUT_MS=

# Private Cloudflare R2 bucket for Professional/Enterprise call recording playback.
# All four values are required before recordings can be persisted and played.
# R2_CALL_RECORDINGS_ACCOUNT_ID=
# R2_CALL_RECORDINGS_ACCESS_KEY_ID=
# R2_CALL_RECORDINGS_SECRET_ACCESS_KEY=
# R2_CALL_RECORDINGS_BUCKET=ringbooker-call-recordings-private

# Google AI
GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxx
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Square Appointments
# OAuth Redirect URL in Square Developer Dashboard (must match exactly, including https and path):
#   {APP_BASE_URL}/api/backend/user/calendar/providers/square_appointments/connect/callback
# Use the Sandbox application for SQUARE_APPLICATION_ID / SECRET when SQUARE_ENVIRONMENT=sandbox.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-01-22
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# Acuity Scheduling
# OAuth Redirect URL in Acuity OAuth app settings (must match exactly):
#   {APP_BASE_URL}/api/backend/user/calendar/providers/acuity/connect/callback
# Register at https://acuityscheduling.com/oauth2/register
ACUITY_CLIENT_ID=
ACUITY_CLIENT_SECRET=
ACUITY_REDIRECT_URI=

# OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# OpenAI Realtime SIP (Telnyx → sip:{proj}@sip.api.openai.com) — pilot / demo
# POST …/realtime/calls/{id}/accept includes `audio.input.turn_detection` from the same AGENT_OPENAI_* vars as the agent worker
# (AGENT_OPENAI_TURN_DETECTION=semantic_vad|server_vad, AGENT_OPENAI_SEMANTIC_VAD_EAGERNESS, AGENT_OPENAI_VAD_*, AGENT_OPENAI_CREATE_RESPONSE, …).
# Webhook URL (RingBooker backend): /api/backend/webhooks/openai
OPENAI_SIP_WEBHOOK_ENABLED=true
OPENAI_WEBHOOK_SECRET=
OPENAI_WEBHOOK_MAX_SKEW_SECONDS=300
OPENAI_SIP_ACCEPT_ENABLED=false
# When true: after SIP accept, opens Realtime sideband WebSocket (required for assistant speech + tool execution).
OPENAI_SIP_SIDEBAND_ENABLED=false
# JSON array — pilot allowlist + fallback when no web session matches caller phone.
# `vertical` / default shop are used only if there is no latest demo_sessions row for that From number.
# Match rules: (1) SIP `To` E.164 equals `did`, or (2) Telnyx TeXML → OpenAI: `To` is sip:proj_…@sip.api.openai.com and
# `proj_…` equals OPENAI_REALTIME_PROJECT_ID below — then the **first** array entry supplies vertical/shop (its `did` should still be your PSTN pilot number for clarity).
# Example: [{"did":"+15551234001","vertical":"nail-salon","defaultShopName":"RingBooker demo"}]
OPENAI_SIP_DEMO_DID_MAP_JSON=
# Vertical demo inbound E.164 (merged into SIP demo DID map; OPENAI_SIP_DEMO_DID_MAP_JSON overrides same DID).
# Marketing /demo/* pages use the same values as defaults when unset.
DEMO_PHONE_NAIL_SALON=+16265013960
DEMO_PHONE_HAIR_SALON=+16286820026
DEMO_PHONE_DAY_SPA=+16282025809
DEMO_PHONE_MED_SPA=+13083020242
DEMO_PHONE_BEAUTY_CLINIC=+12702031876
# Optional: fallback vertical slug for getDemoVerticalByPhoneNumber helper only (SIP still rejects unknown DIDs).
# DEMO_PHONE_FALLBACK_VERTICAL=nail-salon
# No JSON map match: inbound DID is resolved from SIP headers (To, P-Asserted-Identity, Diversion, X-Telnyx-Called-Number)
# against active shops (telnyx_number, then phone_number) when the backend has a shops repository (production).
# Should match the proj_… in OPENAI_SIP_URI / webhook To. If unset, proj id is taken from OPENAI_SIP_URI for DID resolution.
OPENAI_REALTIME_PROJECT_ID=proj_OfhGoB6EVzK2LKZ5vAyZIcH8
# Telnyx TeXML Voice URL (POST|GET /api/backend/telnyx/texml/inbound) — <Dial><Sip> target. Replace proj_… with your OpenAI project id.
# OPENAI_SIP_URI=sip:proj_OfhGoB6EVzK2LKZ5vAyZIcH8@sip.api.openai.com;transport=tls
OPENAI_SIP_URI=
# Preferred Realtime model for SIP accept (falls back to AGENT_VOICE_MODEL).
# OPENAI_REALTIME_MODEL=gpt-realtime
# Optional: pin one OpenAI Realtime voice for SIP. Leave unset — voice follows vertical (nail→shimmer, hair→coral, …).
# OPENAI_REALTIME_SIP_VOICE=
# SIP shop tools: VOICE_TRANSPORT=openai_sip_direct uses request_human_handoff (Telnyx Call Control). LiveKit transfer_to_user is for livekit_media / legacy only.

# Next.js: show inbound SIP pilot panel on /demo/* (optional)
NEXT_PUBLIC_OPENAI_SIP_DEMO_UI=false
NEXT_PUBLIC_OPENAI_SIP_DEMO_NUMBER=
# Next.js: verbose browser console for /demo/* direct OpenAI WebRTC (VAD, greeting, mic). Never logs clientSecret.
NEXT_PUBLIC_DEMO_WEB_REALTIME_DEBUG=false
# Server-side website import endpoint kill switch. Keep false until static import QA passes.
WEBSITE_IMPORT_ENABLED=false
# Next.js: onboarding copy/CTA assumes automated website extraction is active. Keep aligned with WEBSITE_IMPORT_ENABLED for beta.
NEXT_PUBLIC_WEBSITE_IMPORT_ACTIVE=false
GOOGLE_PLACES_API_KEY=
WEBSITE_IMPORT_LLM_ENABLED=false
WEBSITE_IMPORT_LLM_MODEL=gpt-4.1-mini
WEBSITE_IMPORT_LLM_MAX_TOKENS=1800
# Cross-instance daily cap on website-import LLM extraction calls (cost guardrail).
# When the cap is hit, imports still succeed via static + Google Places extraction
# (no LLM enrichment). Requires REDIS_URL to enforce across instances.
WEBSITE_IMPORT_LLM_GLOBAL_DAILY_LIMIT=500
WEBSITE_IMPORT_LLM_GLOBAL_WINDOW_SECONDS=86400
WEBSITE_IMPORT_SERVICE_RETRY_ENABLED=false
WEBSITE_IMPORT_SERVICE_RETRY_MODEL=gpt-4.1-mini
WEBSITE_IMPORT_DIFFICULT_FALLBACK_MODEL=gpt-5.4-mini
WEBSITE_IMPORT_SERVICE_RETRY_MAX_PAGES=12
WEBSITE_IMPORT_SERVICE_RETRY_TIMEOUT_MS=20000
WEBSITE_IMPORT_SERVICE_RETRY_MIN_SERVICE_COUNT=15
WEBSITE_IMPORT_POLICY_RETRY_ENABLED=false
WEBSITE_IMPORT_POLICY_RETRY_MODEL=
WEBSITE_IMPORT_POLICY_RETRY_FALLBACK_MODEL=gpt-5.4-mini
WEBSITE_IMPORT_POLICY_RETRY_MAX_PAGES=8
WEBSITE_IMPORT_POLICY_RETRY_TIMEOUT_MS=20000
WEBSITE_IMPORT_POLICY_RETRY_MIN_POLICY_COUNT=3
WEBSITE_IMPORT_STAFF_RETRY_ENABLED=false
WEBSITE_IMPORT_STAFF_RETRY_MODEL=
WEBSITE_IMPORT_STAFF_RETRY_FALLBACK_MODEL=gpt-5.4-mini
WEBSITE_IMPORT_STAFF_RETRY_MAX_PAGES=6
WEBSITE_IMPORT_STAFF_RETRY_TIMEOUT_MS=20000
WEBSITE_IMPORT_STAFF_RETRY_MIN_STAFF_COUNT=2
WEBSITE_IMPORT_DEBUG_LOG=false
WEBSITE_IMPORT_DEBUG_SAVE_TEXT=false
WEBSITE_IMPORT_MAX_BYTES=1500000
# Optional headless-render service for JS-rendered sites (Wix, SPAs, booking-platform profiles).
# Provider-agnostic: must accept POST { url } and return raw HTML or JSON { html }.
# Works with Browserless, ScrapingBee, a self-hosted Playwright endpoint, etc. Leave blank to disable.
WEBSITE_IMPORT_RENDER_URL=
WEBSITE_IMPORT_RENDER_API_KEY=

# Google OAuth (User login/signup with Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxx
# Prisma/blog: use Supabase Postgres connection string (Settings → Database)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Paddle
BILLING_PROVIDER=paddle
# Keep false until Paddle sandbox checkout + webhooks have passed manual QA.
BILLING_CHECKOUT_ENABLED=false
# Controls Paddle-hosted Customer Portal / Manage Billing only.
BILLING_MANAGE_ENABLED=false
# Controls normalized grouped service catalog UI/API. Enable only after migrations 0045, 0046, and 0047 are applied.
SERVICE_CATALOG_ENABLED=false
PADDLE_API_KEY=ptl_xxxxxxxxxxxx
PADDLE_CLIENT_TOKEN=pdl_client_xxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxx
PADDLE_WEBHOOK_MAX_SKEW_SECONDS=300
PADDLE_ENV=sandbox
# Backward-compatible alias; PADDLE_ENV takes precedence when both are set.
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_STARTER_MONTHLY=pri_xxxxxxxxx
PADDLE_PRICE_STARTER_ANNUAL=pri_xxxxxxxxx
PADDLE_PRICE_PROFESSIONAL_MONTHLY=pri_xxxxxxxxx
PADDLE_PRICE_PROFESSIONAL_ANNUAL=pri_xxxxxxxxx
# Legacy monthly aliases; keep unset for new deployments.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PROFESSIONAL=
PADDLE_PRICE_ENTERPRISE=
# Set true only after Paddle prices are configured to collect a payment method now
# and not charge until the 14-day trial ends.
PADDLE_TRIAL_CONFIG_VERIFIED=false
# When true (and only if it matches server billing behavior), marketing pages may show
# “You won’t be charged until your trial ends” next to trial copy.
NEXT_PUBLIC_PADDLE_TRIAL_CONFIG_VERIFIED=false

# App security
APP_ENCRYPTION_KEY=replace_with_32_plus_characters_secret_key
APP_SIGNING_SECRET=replace_with_32_plus_characters_secret_key

# Runtime defaults
DEFAULT_SHOP_TIMEZONE=America/Los_Angeles
CALENDAR_TIMEOUT_MS=3000
BOOKING_TIMEOUT_MS=5000
SMS_TIMEOUT_MS=4000
TRANSFER_TIMEOUT_MS=5000
# Contact form + transactional email: use Resend. noop = no emails sent (form still returns ok).
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS="RingBooker <notifications@send.ringbooker.com>"
EMAIL_FOUNDER_FROM="Luis Pham from RingBooker <luis@send.ringbooker.com>"
EMAIL_REPLY_TO=hello@ringbooker.com
# Required when EMAIL_PROVIDER=resend. Get from https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_SALES_EMAIL=hello@ringbooker.com
EMAIL_SUPPORT_ADDRESS=support@ringbooker.com
REDIS_URL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public browser demo: OpenAI Realtime WebRTC (required for UpMySalon partner + RingBooker /demo).
# NEXT_PUBLIC_DEMO_WEB_CALL_MODE=direct_openai
# DEMO_WEB_CALL_MODE=direct_openai
# Partner embed (UpMySalon): allowlisted Origins only — never "*".
# DEMO_PARTNER_ORIGINS=https://upmysalon.com,https://staging.upmysalon.com
# DEMO_PARTNER_KEY=  # long random secret; partners send as X-Demo-Partner-Key
# PUBLIC_DEMO_PARTNER_ORIGIN_LIMIT=40
# PUBLIC_DEMO_PARTNER_ORIGIN_WINDOW_SECONDS=3600
# Also add partner hostnames to the Cloudflare Turnstile widget (dashboard) that owns NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# Google Tag Manager (default container GTM-W3SF4NH5 if unset). Set to empty or "false" to disable.
NEXT_PUBLIC_GTM_ID=GTM-W3SF4NH5
# Local debug only. Keep false in staging/production.
NEXT_PUBLIC_SHOW_DEV_RESET_TOKEN=false
# Blog admin cover upload: browser console logs (rebuild after change). Server: LOG_BLOG_COVER=1 for verbose paths/mime.
NEXT_PUBLIC_LOG_BLOG_COVER=false
# Social link previews (Open Graph / X / LinkedIn). Full https URL, or leave unset to use `public/images/og_ringbooker.jpg`.
NEXT_PUBLIC_SITE_OG_IMAGE=
LOG_BLOG_COVER=false
# Optional escape hatch for production only.
# Default production behavior blocks manual (fake-success) calendar provider.
# ALLOW_MANUAL_CALENDAR_PROVIDER=false
PUBLIC_DEMO_SHOP_ID=demo-shop
CALENDAR_TOKEN_CACHE_TTL_SECONDS=3300
CALENDAR_FREEBUSY_CACHE_TTL_SECONDS=45
CALENDAR_SINGLEFLIGHT_LOCK_MS=2500
# Optional default provider when shop has no explicit provider hint.
# Supported ids: manual | google_calendar | vagaro | square_appointments | mindbody | booksy
CALENDAR_PROVIDER_DEFAULT=manual
JOB_POLL_INTERVAL_MS=5000
JOB_LEASE_SECONDS=60

# Staging E2E playbook (optional)
STAGING_E2E_USER_EMAIL=
STAGING_E2E_USER_PASSWORD=
STAGING_E2E_SERVICE_NAME=Manicure
STAGING_E2E_JOB_TICKS=3
RECON_LOOKBACK_DAYS=30
RECON_MAX_ROWS=2000
RECON_APPLY=false

# Provider event replay (safe mode; paddle automated, telnyx manual)
REPLAY_PROVIDER=paddle
REPLAY_LOOKBACK_DAYS=14
REPLAY_MAX_ROWS=200
REPLAY_ONLY_FAILED=true
REPLAY_PROVIDER_EVENT_ID=
REPLAY_APPLY=false
